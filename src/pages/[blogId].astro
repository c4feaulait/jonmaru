---
import BlogDate from "../components/BlogDate.astro";
import Layout from "../layouts/Layout.astro";
import Pagination from "../components/Pagination.astro";
import { getCollection } from "astro:content";
import Tableofcontent from "src/components/Tableofcontent.astro";
import * as cheerio from "cheerio";

// 詳細記事ページの全パスを取得
export async function getStaticPaths() {
    const blogs = await getCollection("blogs");
	// 日付順に並び替え（新しい順）
	const sortedBlogs = blogs.sort(
		(a, b) =>
			new Date(b.data.publishedAt).getTime() -
			new Date(a.data.publishedAt).getTime()
	);

	return sortedBlogs.map((blog) => ({
		params: {
			blogId: blog.id,
		},
		props: {
			blog,
			blogs: sortedBlogs,
		},
	}));
}

// 記事の詳細情報を取得
const { blog, blogs } = Astro.props;

// 現在の記事index
const currentIndex = blogs.findIndex((b) => b.id === blog.id);

// 前後の記事
const prevPost = blogs[currentIndex + 1];
const nextPost = blogs[currentIndex - 1];

const { content } = blog.data;
const $ = cheerio.load(content);
const toc = $("h2").toArray().map((el) => ({
    id: el.attribs.id ?? "",
    text: $(el).text(),
    tag: el.tagName,
}));

---

<Layout title="My first blog with Astro">
    <main>
    </main>
    <main class="sub">
        <section class="notes">
            <div class="container">
                {
                    blog ? (
                        <>
                        <article>
                                <div class="article__inner">
                                    <figure class="post__thumb">
                                    <img
                                        src={blog.data.thumbnail?.url ?? "/images/no-image.png"}
                                        alt={blog.data.title}
                                    />
                                </figure>
                                <div class="post-title__wrapper">
                                    <h1 class="post-title">{blog.data.title}</h1>
                                    <div class="post__inner">
                                        <BlogDate date={blog.data.publishedAt} />
                                        <span class="notes__category">diary</span>
                                    </div>
                                </div>
                                    <Tableofcontent  tocItems={toc} />
                                    <div class="post" set:html={content}>
                                </div>
                            </div>
                        </article>
                        </>
                    ) : (
                        <p>記事がありません。</p>
                    )
                }
            </div>
        </section>
        <Pagination prevPost={prevPost? prevPost.id : null} nextPost={nextPost? nextPost.id : null} />
    </main>
</Layout>

<style lang="scss">
    .article__inner {
        padding-top: 64px;
    }
    @include mq('md') {
        .article__inner {
            display: grid;
            grid-template-columns: 1fr 2fr;
            grid-template-rows: auto 2fr;
        }
    }
    
</style>