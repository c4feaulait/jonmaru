---
import Layout from "../layouts/Layout.astro";
import BlogCard from "src/components/BlogCard.astro"; 
import { getCollection } from "astro:content";


const blogs = await getCollection("blogs");
	// 日付順に並び替え（新しい順）
const sortedBlogs = blogs.sort(
		(a, b) =>
			new Date(b.data.publishedAt).getTime() -
			new Date(a.data.publishedAt).getTime()
);

sortedBlogs.map((blog) => ({
  params: {
			blogId: blog.id,
		},
		props: {
			blog,
			blogs: sortedBlogs,
		},
}));

---

<Layout title="記録の置き場">
  <main>
    <section class="notes">
      <div class="container">
        <h1 class="section-title">Notes</h1>
        
    <ul class="notes__list">
      {
        blogs.length > 0 ? (
          blogs.map((blog) => (
            <BlogCard
              blogID = {blog.id}
              blogThumb = {blog.data.thumbnail?.url}
              blogTitle = {blog.data.title}
              blogDate = {blog.data.publishedAt}
            />
          ))
        ) : (
          <p>記事がありません。</p>
        )
      }
    </ul>
      </div>
    </section>
  </main>
</Layout>