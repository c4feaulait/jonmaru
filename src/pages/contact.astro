---
import Layout from "../layouts/Layout.astro";

const siteTitle = import.meta.env.SITE_TITLE;
const pageTitle = `お問い合わせ｜${siteTitle}`;


---

<Layout title={pageTitle}>
  <main>
  </main>
  <main class="sub">
    <section class="notes">
      <div class="container">
        <figure class="post__thumb">
          <img
              src="/images/no-image.png"
              alt=""
          />
        </figure>
        <hgroup>
          <h1 class="page-title">お問い合わせ</h1>
          <p class="page-title--en">contact</p>
        </hgroup>
        <div class="inner">
          <form class="menu__form" action="https://www.ssgform.com/s/wwdTnS86IVLu" method="post">
            <p>内容に誤りや改善点･ご意見などございましたら下記フォームよりお知らせください。<br><a href="/policy">プライバシーポリシーはこちら</a>
            </p>
            <p class="contact__text--s">※返信できません<br>※個人情報は書かないでください</p>
              <textarea name="コメント" rows="5" placeholder="こちらにご記入ください" required></textarea>
              <button class="submit" type="submit">送信する</button>
            </form>
            </div>
          </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .menu__form {
    display: grid;
    row-gap: 1lh;
  }

  a {
    border-bottom: 1px solid currentColor;
  }

  .contact__text--s {
    font-size: calc(12 * var(--to-rem));
  }
  
  textarea {
    background-color: var(--_bg-color);
    padding: 8px;
    resize: vertical;
  }

  .submit {
    display: block;
    width: fit-content;
    padding: 3px 8px;
    margin-inline: auto;
    border: none;
  }

</style>