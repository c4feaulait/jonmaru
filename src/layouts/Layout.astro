---
import Header from "../components/Header.astro";
import "../styles/index.scss";


const siteTitle = import.meta.env.SITE_TITLE;
const siteDescription = import.meta.env.SITE_DESCRIPTION;

const { title } = Astro.props;
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title> { title } </title>
		<meta name="description" content={siteDescription}>
		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400..800;1,400..800&family=Zen+Kaku+Gothic+New:wght@300;400;500;700&display=swap" rel="stylesheet">
		<!-- リセットCSS -->
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/kiso.css@latest/kiso.css">
        <!-- Search Console -->
        <meta name="google-site-verification" content="jLAMJ4b1GAFEVx1HyDmnE7BuP-nQ4_wfLol91ifnqaE" />
		
	</head>
	<body>
		<Header />
		<slot />
	</body>
</html>

