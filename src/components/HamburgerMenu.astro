<style lang="scss">
    h2 {
        font-family: var(--font-en);
        font-weight: 500;
        font-size: calc(24 * var(--to-rem));
    }

    .hamburger-menu {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        padding-top: 80px;
        background-color: var(--_bg-color);
        z-index: -1;
        opacity: 0;
        visibility: hidden;
        transition: all .6s cubic-bezier(0.2, 1.55, 0.5, .9);

        &.is-open {
            opacity: 1;
            visibility: visible;
        }
    }

    .hamburger-menu__inner {
        display: grid;
        row-gap: 1lh;
        margin-top: 12px;
    }

    .hamburger-menu__text {
        text-align: right;
    }

    .hamburger-menu__nav {
        margin-top: 20px;
        padding-top: 20px;
        border-top: 1px solid var(--color-border);
    }

    .hamburger-menu__list {
        display: grid;
        row-gap: 6px;
    }

    .hamburger-menu__link {
        color: var(--color-accent);
    }


</style>
